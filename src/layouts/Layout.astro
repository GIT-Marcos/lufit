---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export interface BreadcrumbItem {
  label: string;
  href: string;
}

export interface Props {
  title: string;
  description?: string;
  breadcrumb?: BreadcrumbItem[];
}

const { title, description, breadcrumb } = Astro.props;
const currentPage = Astro.url.pathname.replace(/\/$/, "") || "/";
const siteOrigin = Astro.site?.origin ?? Astro.url.origin;
const canonicalUrl = siteOrigin + (Astro.url.pathname.replace(/\/$/, "") || "/");
const ogImage = "https://placehold.co/1200x630/EA580C/FFFFFF?text=Ludmila+PT";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Ludmila PT" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Ir al contenido</a>
    <Header currentPage={currentPage} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    {
      breadcrumb && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            itemListElement: breadcrumb.map((item, index) => ({
              "@type": "ListItem",
              position: index + 1,
              name: item.label,
              item: siteOrigin + item.href,
            })),
          })}
        />
      )
    }
  </body>
</html>
