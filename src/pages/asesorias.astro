---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Button from "../components/Button.astro";
import Comparativa from "../components/Comparativa.astro";
import Steps from "../components/Steps.astro";
import FAQ from "../components/FAQ.astro";
import bannerImage from "../assets/images/hero/asesorias-hero.svg";
import { CONTACTO } from "../data/contacto";
import { COMPARATIVA_COLUMNAS, STEPS, DIFERENCIALES } from "../data/asesorias";

const paraQuien = [
  { texto: 'Para las que quieren ganar fuerza, masa muscular y movilidad', icono: '🏃‍♀️' },
  { texto: 'Para las mujeres que quieren sobre todo sentirse saludable, segura y con más energía', icono: '💃' },
  { texto: 'Para las que necesitan lograr que entrenar sea una parte central en su vida', icono: '📈' },
  { texto: 'Para las mujeres que buscan transformar la relación que tienen con su cuerpo', icono: '🤸‍♀️' },
];

const paraQuienNoEs = [
  { texto: 'Mujeres que buscan resultados mágicos sin esfuerzo', icono: '🚫' },
  { texto: 'Quienes esperan ver cambios en una semana', icono: '🚫' },
  { texto: 'Las que no están dispuestos a recibir correcciones técnicas', icono: '🚫' },
  { texto: 'Unicamente querés perder peso y nada más', icono: '🚫' },
];

const faqItems = [
  { pregunta: '¿Cómo inicio?', respuesta: 'Llenás el formulario desde el botón "Armemos tu plan" y yo me pondré en contacto con vos para que juntas armemos un plan de entrenamiento.' },
  { pregunta: '¿Necesito experiencia previa para empezar?', respuesta: 'No, deseño los planes para cualquier nivel de experiencia. Arrancamos desde donde estés.' },
  { pregunta: '¿Cuántos días a la semana entreno?', respuesta: 'Depende de tu objetivo y disponibilidad. Lo definimos juntos en el plan de entrenamiento.' },
  { pregunta: '¿Cada cuánto se ajusta la rutina?', respuesta: 'Se ajusta según tu evolución. Las rutinas personalizadas van adaptándose a tu crecimiento y necesidades. Puede ser semanalmente o mensualmente dependiendo de las circunstancias.' },
  { pregunta: '¿Cómo son los pagos?', respuesta: 'Coordinamos mes a mes. Podrás consultame por los medios de pago disponibles y montos.' },
  { pregunta: '¿Necesito equipamiento como pesas, bandas elásticas, etc.?', respuesta: 'No es necesario. Puedo armarte un plan en el que no se necesite nigún tipo de equipamiento. Si tenés bandas, mancuernas podés usarlo, yo te diré cómo.' },
  /*
  { pregunta: '¿Qué necesito para la modalidad online?', respuesta: 'Solo espacio en tu casa, conexión a internet y ganas de entrenar. El equipamiento lo adaptamos a lo que tengas.' },
  { pregunta: '¿Puedo combinar online y presencial?', respuesta: 'Sí, muchos alumnos combinan ambas modalidades según su semana.' },
  { pregunta: '¿Qué pasa si no puedo una semana?', respuesta: 'No hay problema, ajustamos el plan. La comunicación es clave para adaptarnos.' },
  */
];
---

<Layout
  title="Planes Personalizados con Seguimiento"
  description="Planes de entrenamiento a tu medida con acompañamiento continuo. Online o presencial. Consultá sin compromiso."
  breadcrumb={[
    { label: "Inicio", href: "/" },
    { label: "Asesorías", href: "/asesorias" },
  ]}
>
  <Hero
    title="Un plan que se adapta a vos —no al revés—"
    subtitle="Online o presencial, vos elegís"
    image={{ src: bannerImage.src, alt: "Ludmila entrenando con una alumna" }}
    ctas={[
      {
        text: "Armemos tu plan",
        href: CONTACTO.FORM_EVALUACION_URL,
        variant: "evaluacion",
        size: "lg",
        icon: "form",
        target: "_blank",
        rel: "noopener noreferrer",
      },
    ]}
  />

  <section id="presencial" class="section">
    <div class="section__container">
      <h2 class="section__title">Online es mi especialidad</h2>
      <p class="section__texto">
        El entrenamiento online me permite acompañarte estés donde estés, sin depender de horarios fijos ni traslados. 
        También ofrezco opciones presenciales con cupos limitados — consultame si te va mejor.
      </p>
      <Comparativa
        columnas={COMPARATIVA_COLUMNAS}
      />
    </div>
  </section>

  <section class="section section--featured">
    <div class="section__container">
      <h2 class="section__title">Cómo funciona</h2>
      <Steps
        steps={STEPS}
      />
    </div>
  </section>

  <section class="section section--featured">
    <div class="section__container">
      <h2 class="section__title">¿Por qué es diferente?</h2>
      <div class="diferenciales-grid">
        {
          DIFERENCIALES.map((d) => (
            <div class="diferencial">
              <span class="diferencial__icono" aria-hidden="true">{d.icono}</span>
              <p class="diferencial__texto">{d.texto}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--featured">
    <div class="section__container">
      <h2 class="section__title">¿Para quién es?</h2>
      <div class="para-quien-grid">
        {
          paraQuien.map((item) => (
            <div class="para-quien-item">
              <span class="para-quien-item__icono" aria-hidden="true">
                {item.icono}
              </span>
              <p class="para-quien-item__texto">{item.texto}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <h2 class="section__title">¿Para quién no es?</h2>
      <p class="section__texto">
        Esto no es para todos, y está bien. Si te identificás con alguno de estos perfiles,
        quizás este no sea tu momento — y no hay nada de malo en eso.
      </p>
      <div class="para-quien-grid">
        {
          paraQuienNoEs.map((item) => (
            <div class="para-quien-item">
              <span class="para-quien-item__icono" aria-hidden="true">
                {item.icono}
              </span>
              <p class="para-quien-item__texto">{item.texto}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container section__container--narrow">
      <h2 class="section__title">Preguntas frecuentes</h2>
      <FAQ items={faqItems} />
    </div>
  </section>

  <section class="section section--cta">
    <div class="section__container">
      <h2 class="section__title">¿LISTA PARA EMPEZAR TU TRANSFORMACIÓN?</h2>
      <Button
        href={CONTACTO.FORM_EVALUACION_URL}
        variant="evaluacion"
        size="lg"
        icon="form"
        target="_blank"
        rel="noopener noreferrer">Armemos tu plan</Button
      >
    </div>
  </section>
</Layout>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.pregunta,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.respuesta,
      },
    })),
  })}
/>

<style>
  .diferenciales-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    max-width: 48rem;
    margin: 0 auto;
  }

  .diferencial {
    display: flex;
    gap: 0.875rem;
    align-items: flex-start;
    padding: 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    transition: transform var(--transition-base),
                box-shadow var(--transition-base);
  }

  .diferencial:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }

  .diferencial__icono {
    flex-shrink: 0;
    font-size: 1.375rem;
    width: 1.75rem;
    text-align: center;
    line-height: 1.5;
  }

  .diferencial__texto {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text);
  }

  .para-quien-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 48rem;
    margin: 0 auto;
  }

  .para-quien-item {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 1.25rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    transition: transform var(--transition-base),
                box-shadow var(--transition-base);
  }

  .para-quien-item:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }

  .para-quien-item__icono {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .para-quien-item__texto {
    font-size: 1rem;
    line-height: 1.5;
    font-weight: 500;
  }

  @media (min-width: 768px) {
    .diferenciales-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .para-quien-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
