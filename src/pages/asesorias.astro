---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Button from "../components/Button.astro";
import Comparativa from "../components/Comparativa.astro";
import Steps from "../components/Steps.astro";
import FAQ from "../components/FAQ.astro";
import bannerImage from "../assets/images/asesorias-placeholder.svg";
import { CONTACTO } from "../data/contacto";

const diferenciales = [
  "Planes 100% a tu medida — no hay rutinas genéricas ni copiadas",
  "Ajustes semanales según tu evolución real",
  "Acompañamiento por WhatsApp — no soy un bot, respondo yo",
  "Corrección de técnica para evitar lesiones y maximizar resultados",
  "Flexibilidad total: online, presencial o combinado",
  "No necesitás experiencia previa — arrancamos desde donde estés",
];

const paraQuien = [
  { texto: 'Principiantes que nunca pisaron un gimnasio', icono: '🏃' },
  { texto: 'Personas que quieren retomar después de un tiempo', icono: '🔄' },
  { texto: 'Intermedios que estancaron y no ven resultados', icono: '📈' },
  { texto: 'Cualquiera que busque un cambio real con acompañamiento profesional', icono: '🎯' },
];

const faqItems = [
  { pregunta: '¿Necesito experiencia previa para empezar?', respuesta: 'No, los planes están diseñados para cualquier nivel. Arrancamos desde donde estés.' },
  { pregunta: '¿Cuántos días a la semana entreno?', respuesta: 'Depende de tu objetivo y disponibilidad. Lo definimos juntos en la evaluación inicial.' },
  { pregunta: '¿Qué necesito para la modalidad online?', respuesta: 'Solo espacio en tu casa, conexión a internet y ganas de entrenar. El equipamiento lo adaptamos a lo que tengas.' },
  { pregunta: '¿Cada cuánto se ajusta la rutina?', respuesta: 'Semanalmente según tu evolución. No trabajo con rutinas fijas de un mes.' },
  { pregunta: '¿Puedo combinar online y presencial?', respuesta: 'Sí, muchos alumnos combinan ambas modalidades según su semana.' },
  { pregunta: '¿Hay periodo de prueba o evaluación gratis?', respuesta: 'La primera charla de evaluación es sin cargo para conocernos y definir objetivos.' },
  { pregunta: '¿Cómo son los pagos?', respuesta: 'Coordinamos mes a mes. Consultame por los medios de pago disponibles.' },
  { pregunta: '¿Qué pasa si no puedo una semana?', respuesta: 'No hay problema, ajustamos el plan. La comunicación es clave para adaptarnos.' },
];
---

<Layout
  title="Planes Personalizados con Seguimiento"
  description="Planes de entrenamiento a tu medida con acompañamiento continuo. Online o presencial. Consultá sin compromiso."
  breadcrumb={[
    { label: "Inicio", href: "/" },
    { label: "Asesorías", href: "/asesorias" },
  ]}
>
  <Hero
    title="Planes Personalizados con Seguimiento"
    subtitle="Online o presencial, vos elegís"
    image={{ src: bannerImage.src, alt: "Ludmila entrenando con una alumna" }}
    ctas={[
      { text: "Armemos tu plan", href: CONTACTO.FORM_EVALUACION_URL, variant: "evaluacion", icon: "form", target: "_blank", rel: "noopener noreferrer" },
    ]}
  />

  <section class="section">
    <div class="section__container">
      <h2 class="section__title">¿Online o presencial?</h2>
      <Comparativa
        columnas={[
          {
            titulo: "Online",
            items: [
              "Entrená desde tu casa",
              "Sin traslados, máximo aprovechamiento del tiempo",
              "Seguimiento por videollamada + WhatsApp",
              "Rutina adaptada a tu espacio y equipamiento",
              "Flexibilidad total de horarios",
            ],
          },
          {
            titulo: "Presencial",
            items: [
              "Entrená en mi gimnasio",
              "Corrección de técnica en vivo",
              "Seguimiento presencial sesión a sesión",
              "Acceso a equipamiento completo",
              "Gym con fecha y hora fija",
            ],
          },
        ]}
      />
    </div>
  </section>

  <section class="section section--featured">
    <div class="section__container">
      <h2 class="section__title">Cómo funciona</h2>
      <Steps
        steps={[
          {
            numero: 1,
            titulo: "Llenado de formulario",
            descripcion:
              "Completa el formulario para conocerte, definir objetivos y evaluar tu condición física",
          },
          {
            numero: 2,
            titulo: "Plan a tu medida",
            descripcion:
              "Diseño de rutina personalizada que se ajuste a vos, según tus metas, horarios y equipamiento + guía de alimentación",
          },
          {
            numero: 3,
            titulo: "Seguimiento continuo",
            descripcion:
              "Acompañamiento cercano con ajustes según evolución (online o presencial). Videos explicativos de ejercicios y correcciones de técnica",
          },
          {
            numero: 4,
            titulo: "Resultados reales",
            descripcion:
              "Cambios visibles en fuerza, composición corporal y bienestar general",
          },
        ]}
      />
    </div>
  </section>

  <!--
  <section class="section">
    <div class="section__container">
      <h2 class="section__title">Diferenciales</h2>
      <div class="diferenciales-grid">
        {
          diferenciales.map((d) => (
            <div class="diferencial">
              <span class="diferencial__check" aria-hidden="true">
                ✓
              </span>
              <p class="diferencial__texto">{d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  -->

  <section class="section section--featured">
    <div class="section__container">
      <h2 class="section__title">¿Para quién es?</h2>
      <div class="para-quien-grid">
        {
          paraQuien.map((item) => (
            <div class="para-quien-item">
              <span class="para-quien-item__icono" aria-hidden="true">
                {item.icono}
              </span>
              <p class="para-quien-item__texto">{item.texto}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container section__container--narrow">
      <h2 class="section__title">Preguntas frecuentes</h2>
      <FAQ items={faqItems} />
    </div>
  </section>

  <section class="section section--cta">
    <div class="section__container">
      <h2 class="section__title">¿Lista/o para empezar?</h2>
      <Button href={CONTACTO.FORM_EVALUACION_URL} variant="evaluacion" icon="form" target="_blank" rel="noopener noreferrer">Armemos tu plan</Button>
    </div>
  </section>
</Layout>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.pregunta,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.respuesta,
      },
    })),
  })}
/>

<style>
  .section {
    padding: 4rem 1rem;
  }

  .section--featured {
    background: var(--color-surface);
  }

  .section--cta {
    text-align: center;
    background: var(--color-primary);
    color: white;
  }

  .section--cta .section__title {
    color: white;
    margin-bottom: 1.5rem;
  }

  .section__container {
    max-width: 64rem;
    margin: 0 auto;
  }

  .section__container--narrow {
    max-width: 48rem;
  }

  .section__title {
    text-align: center;
    margin-bottom: 2rem;
  }

  .diferenciales-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    max-width: 48rem;
    margin: 0 auto;
  }

  .diferencial {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
  }

  .diferencial__check {
    color: var(--color-secondary);
    font-weight: 700;
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .diferencial__texto {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .para-quien-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 48rem;
    margin: 0 auto;
  }

  .para-quien-item {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 1.25rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
  }

  .para-quien-item__icono {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .para-quien-item__texto {
    font-size: 0.9375rem;
    line-height: 1.5;
    font-weight: 500;
  }

  @media (min-width: 768px) {
    .diferenciales-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .para-quien-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
