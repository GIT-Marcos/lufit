---
import Layout from "../layouts/Layout.astro";
---
<!-- ===========================================================
     CONTENIDO ORIGINAL COMENTADO
     Restaurar cuando los planes estén listos.
     Las importaciones necesarias están listadas abajo.
     ===========================================================

     import Hero from "../components/Hero.astro";
     import Button from "../components/Button.astro";
     import FAQ from "../components/FAQ.astro";
     import PlanListoCard from "../components/PlanListoCard.astro";
     import { PLANES_LISTOS } from "../data/planes-listos";
     import { getWhatsAppUrl } from "../data/contacto";
     import bannerImage from "../assets/images/planes-listos-placeholder.svg";

     const faqItems = [ ... ];
     const siteOrigin = Astro.site?.origin ?? "";
-->

<Layout
  title="Planes Listos — Próximamente — Ludmila Personal Trainer"
  description="Próximamente: planes de entrenamiento pre-diseñados para ganar masa muscular, perder peso, mejorar resistencia o movilidad."
  breadcrumb={[
    { label: "Inicio", href: "/" },
    { label: "Planes Listos", href: "/planes-listos" },
  ]}
>
  <section class="section section--cta" style="min-height: 60vh; display: flex; align-items: center;">
    <div class="section__container" style="text-align: center;">
      <p style="font-size: 1.5rem; font-weight: 600; margin-bottom: 1rem; color: white;">
        🚧 Próximamente
      </p>
      <h1 class="section__title" style="color: white; margin-bottom: 1.5rem;">
        Nuevos planes listos están en camino
      </h1>
      <p style="font-size: 1.125rem; color: rgba(255,255,255,0.85); max-width: 32rem; margin: 0 auto;">
        Estoy armando programas de entrenamiento específicos para cada objetivo.
        Volvé pronto o seguime en Instagram para enterarte cuando estén disponibles.
      </p>
    </div>
  </section>

  <!--
  ************************************************************
  CONTENIDO ORIGINAL — Descomentar desde aquí hasta el final
  ************************************************************

  <Hero
    title="Planes listos para arrancar"
    subtitle="Elegí tu objetivo y empezá hoy — planes pre-diseñados con estructura profesional"
    image={{ src: bannerImage.src, alt: "Planes de entrenamiento listos para empezar" }}
    ctas={[
      { text: "Ver planes", href: "#planes", variant: "primary", size: "lg" },
      {
        text: "Consultar por WhatsApp",
        href: getWhatsAppUrl(),
        variant: "whatsapp",
        icon: "whatsapp",
        size: "lg",
        target: "_blank",
        rel: "noopener noreferrer",
      },
    ]}
  />

  <section class="section section--sm section--no-separator" aria-label="Qué son los planes listos">
    <div class="section__container section__container--narrow">
      <p class="section__texto">
        Estos planes están armados con ejercicios comprobados y estructura profesional para objetivos específicos.
        Son autoguiados — ideales si ya tenés experiencia o si querés complementar tu entrenamiento actual.
        ¿Necesitás algo más ajustado? <a href="/asesorias">Conocé las asesorías personalizadas</a>.
      </p>
    </div>
  </section>

  <section id="planes" class="section">
    <div class="section__container">
      <h2 class="section__title">Elegí tu plan</h2>
      <div class="planes-grid">
        {
          PLANES_LISTOS.map((plan) => (
            <PlanListoCard plan={plan} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--featured">
    <div class="section__container section__container--narrow">
      <h2 class="section__title">Preguntas frecuentes</h2>
      <FAQ items={faqItems} />
    </div>
  </section>

  <section class="section section--cta">
    <div class="section__container">
      <h2 class="section__title">¿No sabés cuál elegir?</h2>
      <p class="section__texto" style="color: rgba(255,255,255,0.9);">
        Consultame por WhatsApp y te recomiendo el plan ideal para tu objetivo
      </p>
      <Button
        href={getWhatsAppUrl()}
        variant="whatsapp"
        size="lg"
        icon="whatsapp"
        target="_blank"
        rel="noopener noreferrer"
      >
        Consultar por WhatsApp
      </Button>
    </div>
  </section>

  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "BreadcrumbList",
          itemListElement: [
            { "@type": "ListItem", position: 1, name: "Inicio", item: siteOrigin + "/" },
            { "@type": "ListItem", position: 2, name: "Planes Listos", item: siteOrigin + "/planes-listos" },
          ],
        },
        {
          "@type": "ItemList",
          itemListElement: PLANES_LISTOS.map((plan, index) => ({
            "@type": "ListItem",
            position: index + 1,
            item: {
              "@type": "Product",
              name: plan.titulo,
              description: plan.descripcion,
              category: plan.objetivo,
              offers: {
                "@type": "Offer",
                availability: "https://schema.org/InStock",
              },
            },
          })),
        },
        {
          "@type": "FAQPage",
          mainEntity: faqItems.map((item) => ({
            "@type": "Question",
            name: item.pregunta,
            acceptedAnswer: {
              "@type": "Answer",
              text: item.respuesta,
            },
          })),
        },
      ],
    })}
  />

  <style>
    .planes-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    @media (min-width: 768px) {
      .planes-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }
  </style>
  -->
</Layout>
