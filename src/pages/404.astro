---
import "../styles/global.css";
import Button from "../components/Button.astro";
import favicon from "../assets/images/favicon.svg";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={favicon.src} />
    <title>Página no encontrada — Ludmila PT</title>
    <meta name="robots" content="noindex" />
  </head>
  <body class="body-404">
    <main class="main-404">
      <h1 class="title-404">Página no encontrada</h1>
      <p class="subtitle-404">
        Parece que te perdiste... pero siempre estás a tiempo de volver al
        movimiento
      </p>
      <Button href="/" variant="internal" icon="arrow">Volver al inicio</Button>
    </main>
  </body>
</html>

<style>
  .body-404 {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text);
  }

  .main-404 {
    text-align: center;
    padding: 2rem 1rem;
    max-width: 28rem;
  }

  .title-404 {
    font-family: var(--font-hero), sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .subtitle-404 {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 2rem;
  }


</style>
