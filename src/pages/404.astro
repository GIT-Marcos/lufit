---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
---

<Layout
  title="Página no encontrada — Ludmila | Prof. Ed. Física"
  description="La página que buscás no existe. Volvé al inicio para descubrir los planes de entrenamiento online y presencial de Ludmila, Prof. de Ed. Física."
  noindex={true}
>
  <div class="main-404">
    <h1 class="title-404">Página no encontrada</h1>
    <p class="subtitle-404">
      Parece que te perdiste... pero siempre estás a tiempo de volver al
      movimiento
    </p>
    <Button href="/" variant="internal" icon="arrow">Volver al inicio</Button>
  </div>
</Layout>

<style>
  .main-404 {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4rem 1rem;
    max-width: 28rem;
    margin: 0 auto;
  }

  .title-404 {
    font-family: var(--font-hero), sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .subtitle-404 {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 2rem;
  }
</style>
