---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import ContactIcons from "../components/ContactIcons.astro";
import { CONTACTO } from "../data/contacto";

const galeria = [
  {
    src: "/images/LibraFit.jpg",
    alt: "Logo de LibraFit",
  },
  {
    src: "https://placehold.co/800x600/1C1917/FAFAF9?text=Equipamiento",
    alt: "Equipamiento del gimnasio",
  },
  {
    src: "https://placehold.co/800x600/EA580C/FFFFFF?text=Ambiente",
    alt: "Ambiente del gimnasio de Ludmila",
  },
  {
    src: "https://placehold.co/800x600/1C1917/FAFAF9?text=Box+de+entrenamiento",
    alt: "Box de entrenamiento personal",
  },
];
---

<Layout
  title="Mi Espacio de Entrenamiento"
  description="Conocé mi gimnasio y las sesiones presenciales con Ludmila. También disponible 100% online. Elegí la modalidad que mejor se adapte a vos."
  breadcrumb={[
    { label: "Inicio", href: "/" },
    { label: "Mi Gimnasio", href: "/mi-gimnasio" },
  ]}
>
  <section class="hero-gimnasio">
    <img
      src="https://placehold.co/1200x600/EA580C/FFFFFF?text=Ludmila+en+mi+gimnasio"
      alt="Ludmila en su gimnasio"
      class="hero-gimnasio__image"
      fetchpriority="high"
    />
    <div class="hero-gimnasio__content">
      <h1 class="hero-gimnasio__title">Así trabajo. Presencial u online.</h1>
      <p class="hero-gimnasio__texto">
        Este es el espacio donde entrenan mis alumnas presenciales. El mismo
        método, el mismo acompañamiento, funciona igual de bien donde sea que
        estés.
      </p>
      <div class="hero-gimnasio__cta">
        <Button href="/asesorias" variant="internal" icon="arrow" size="lg">
          Ver planes online
        </Button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <h2 class="section__title">Mi espacio presencial</h2>
      <div class="galeria-grid">
        {
          galeria.map((foto) => (
            <img
              src={foto.src}
              alt={foto.alt}
              class="galeria__img"
              loading="lazy"
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--sm">
    <div class="section__container section__container--narrow">
      <h2 class="section__title">Para comenzar presencial contactame por acá</h2>
      <ContactIcons whatsappMessage="¡Hola! Quiero consultar por las sesiones presenciales en tu gimnasio." />
    </div>
  </section>

  <section class="section section--featured">
    <div class="section__container section__container--narrow">
      <h2 class="section__title">El mismo método, donde sea que estés</h2>
      <p class="section__texto">
        Mi plan online tiene el mismo nivel de personalización, seguimiento
        y corrección que el presencial. Sin traslados, con flexibilidad total.
        Entrená cuando quieras, donde quieras.
      </p>
      <div class="section__cta-wrapper">
        <Button
          href={CONTACTO.FORM_EVALUACION_URL}
          variant="evaluacion"
          icon="form"
          size="lg"
          target="_blank"
          rel="noopener noreferrer"
        >
          Empezá con tu plan online
        </Button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container section__container--narrow">
      <h2 class="section__title">Dirección y horarios</h2>
      <div class="info-box">
        <p class="info-box__line">
          Dirección: [Dirección del gimnasio — placeholder]
        </p>
        <p class="info-box__line">
          Horarios: Consultá disponibilidad de turnos
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-gimnasio {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    text-align: center;
  }

  .hero-gimnasio__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero-gimnasio__content {
    position: relative;
    z-index: 1;
    background: rgba(255, 255, 255, 0.9);
    padding: 2rem;
    border-radius: 0.75rem;
    max-width: 40rem;
  }

  .hero-gimnasio__title {
    font-family: var(--font-hero), sans-serif;
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .hero-gimnasio__texto {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .hero-gimnasio__cta {
    margin-top: 1.5rem;
  }

  .section__texto {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    text-align: center;
    max-width: 36rem;
    margin: 0 auto 1.5rem;
  }

  .section__cta-wrapper {
    text-align: center;
  }

  .galeria-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .galeria__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0.75rem;
  }

  .info-box {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .info-box__line {
    font-size: 1rem;
    color: var(--color-text-secondary);
  }

  @media (min-width: 768px) {
    .galeria-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .galeria__img {
    }
  }
</style>
