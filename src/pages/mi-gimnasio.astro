---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import ContactIcons from "../components/ContactIcons.astro";
import { CONTACTO } from "../data/contacto";
import { PLANES_PRESENCIALES } from "../data/planes-presenciales";
import libraFitImg from "../assets/images/galeria/LibraFit.jpg";
import heroGimnasioImg from "../assets/images/hero/gimnasio-hero.svg";
import gym1Img from "../assets/images/galeria/gym1.jpeg";
import gym2Img from "../assets/images/galeria/gym2.jpeg";
import gym3Img from "../assets/images/galeria/gym3.jpeg";

const galeria = [
  { src: libraFitImg.src, alt: "Logo de LibraFit" },
  { src: gym1Img.src, alt: "Espacio de entrenamiento — Ludmila PT" },
  { src: gym2Img.src, alt: "Sesión de entrenamiento — Ludmila PT" },
  { src: gym3Img.src, alt: "Box de entrenamiento — Ludmila PT" },
];
---

<Layout
  title="Mi Espacio de Entrenamiento"
  description="Conocé mi gimnasio y las sesiones presenciales con Ludmila. También disponible 100% online. Elegí la modalidad que mejor se adapte a vos."
  breadcrumb={[
    { label: "Inicio", href: "/" },
    { label: "Mi Gimnasio", href: "/mi-gimnasio" },
  ]}
>
  <section class="hero-gimnasio">
    <img
      src={heroGimnasioImg.src}
      alt="Ludmila en su gimnasio"
      class="hero-gimnasio__image"
      fetchpriority="high"
    />
    <div class="hero-gimnasio__content">
      <h1 class="hero-gimnasio__title">Así trabajo. Presencial u online.</h1>
      <p class="hero-gimnasio__texto">
        Este es el espacio donde entrenan mis alumnas presenciales. El mismo
        método, el mismo acompañamiento, funciona igual de bien donde sea que
        estés.
      </p>
      <div class="hero-gimnasio__cta">
        <Button href="/asesorias" variant="internal" icon="arrow" size="lg">
          Ver planes online
        </Button>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="modalidades-heading">
    <div class="section__container">
      <h2 id="modalidades-heading" class="section__title">
        Elegí cómo entrenar presencial
      </h2>

      <div class="planes-grid">
        {
          PLANES_PRESENCIALES.map((plan) => (
            <article class={`plan-card ${plan.destacado ? "plan-card--destacado" : ""}`}>
              {plan.destacado && (
                <span class="plan-card__badge" aria-hidden="true">
                  {plan.destacado}
                </span>
              )}
              <span class="plan-card__icono" aria-hidden="true">{plan.icono}</span>
              <h3 class="plan-card__title">{plan.titulo}</h3>
              <p class="plan-card__descripcion">{plan.descripcion}</p>

              <ul class="plan-card__beneficios">
                {plan.beneficios.map((b) => (
                  <li class="plan-card__beneficio">
                    <span class="plan-card__check" aria-hidden="true">✓</span>
                    <span>{b}</span>
                  </li>
                ))}
              </ul>

              <a
                href={plan.cta.href}
                class="plan-card__cta"
                target="_blank"
                rel="noopener noreferrer"
              >
                {plan.cta.texto}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <h2 class="section__title">Mi espacio presencial</h2>
      <div class="galeria-grid">
        {
          galeria.map((foto) => (
            <img
              src={foto.src}
              alt={foto.alt}
              class="galeria__img"
              loading="lazy"
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--sm">
    <div class="section__container section__container--narrow">
      <h2 class="section__title">Para comenzar presencial contactame por acá</h2>
      <ContactIcons whatsappMessage="¡Hola! Quiero consultar por las sesiones presenciales en tu gimnasio." />
    </div>
  </section>

  <section class="section section--featured">
    <div class="section__container section__container--narrow">
      <h2 class="section__title">El mismo método, donde sea que estés</h2>
      <p class="section__texto">
        Mi plan online tiene el mismo nivel de personalización, seguimiento
        y corrección que el presencial. Sin traslados, con flexibilidad total.
        Entrená cuando quieras, donde quieras.
      </p>
      <div class="section__cta-wrapper">
        <Button
          href={CONTACTO.FORM_EVALUACION_URL}
          variant="evaluacion"
          icon="form"
          size="lg"
          target="_blank"
          rel="noopener noreferrer"
        >
          Empezá con tu plan online
        </Button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container section__container--narrow">
      <h2 class="section__title">Dirección y horarios</h2>
      <div class="info-box">
        <p class="info-box__line">
          Dirección: [Dirección del gimnasio — placeholder]
        </p>
        <p class="info-box__line">
          Horarios: Consultá disponibilidad de turnos
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-gimnasio {
    position: relative;
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    text-align: center;
  }

  .hero-gimnasio__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero-gimnasio__content {
    position: relative;
    z-index: 1;
    background: rgba(255, 255, 255, 0.9);
    padding: 2rem;
    border-radius: 0.75rem;
    max-width: 40rem;
  }

  .hero-gimnasio__title {
    font-family: var(--font-hero), sans-serif;
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 1rem;
  }

  .hero-gimnasio__texto {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .hero-gimnasio__cta {
    margin-top: 1.5rem;
  }

  .section__texto {
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    text-align: center;
    max-width: 36rem;
    margin: 0 auto 1.5rem;
  }

  .section__cta-wrapper {
    text-align: center;
  }

  .galeria-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .galeria__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0.75rem;
  }

  .info-box {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .info-box__line {
    font-size: 1rem;
    color: var(--color-text-secondary);
  }

  @media (min-width: 768px) {
    .galeria-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .galeria__img {
    }
  }

  .planes-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 56rem;
    margin: 0 auto;
  }

  .plan-card {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-align: center;
    align-items: center;
    transition: transform var(--transition-base),
                box-shadow var(--transition-base);
  }

  .plan-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-hover);
  }

  .plan-card--destacado {
    border: 2px solid var(--color-primary);
    background: radial-gradient(
      ellipse at 50% 0%,
      color-mix(in srgb, var(--color-primary), transparent 90%),
      var(--color-surface) 70%
    );
  }

  .plan-card__badge {
    position: absolute;
    top: -0.75rem;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-primary);
    color: white;
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.25rem 1rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .plan-card__icono {
    font-size: 2.5rem;
    line-height: 1;
  }

  .plan-card__title {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .plan-card__descripcion {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 28rem;
  }

  .plan-card__beneficios {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    text-align: left;
    width: 100%;
    max-width: 22rem;
  }

  .plan-card__beneficio {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .plan-card__check {
    flex-shrink: 0;
    color: var(--color-secondary);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.5;
  }

  .plan-card__cta {
    display: inline-block;
    margin-top: auto;
    padding: 0.625rem 1.5rem;
    background: var(--color-primary);
    color: white;
    font-family: var(--font-button), sans-serif;
    font-weight: 600;
    font-size: 0.9375rem;
    border-radius: 999px;
    text-decoration: none;
    transition: background var(--transition-base);
  }

  .plan-card__cta:hover {
    background: var(--color-primary-dark);
    color: white;
  }

  @media (min-width: 768px) {
    .planes-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .plan-card {
      padding: 2.5rem 2rem;
    }
  }
</style>
