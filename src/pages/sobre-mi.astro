---
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import ContactIcons from "../components/ContactIcons.astro";
import Frase from "../components/Frase.astro";
import CertificationCard from "../components/CertificationCard.astro";
import Gallery from "../components/Gallery.astro";
import { CONTACTO } from "../data/contacto";
import { CERTIFICACIONES } from "../data/certificaciones";
import { GALLERY } from "../data/gallery";
import ipefLogo from "../assets/images/certificaciones/ipef.png";
import amaipLogo from "../assets/images/certificaciones/amaip.png";
import retratoPlaceholder from "../assets/images/about/retrato.svg";

const certLogos: Record<string, string> = {
  "IPEF": ipefLogo.src,
  "AMAIP": amaipLogo.src,
};
---

<Layout
  title="Sobre Ludmila — Entrenadora Personal Certificada"
  description="Conocé a Ludmila, entrenadora personal certificada. Filosofía, certificaciones y experiencia. Entrenamiento online y presencial en La Calera, Córdoba."
  breadcrumb={[
    { label: "Inicio", href: "/" },
    { label: "Sobre Mí", href: "/sobre-mi" },
  ]}
>
  <section class="hero-sobremi">
    <div class="hero-sobremi__content">
      <img
        src={retratoPlaceholder.src}
        alt="Retrato de Ludmila, personal trainer"
        class="hero-sobremi__image"
        fetchpriority="high"
      />
      <h1 class="hero-sobremi__title">Ludmila — Personal Trainer</h1>
      <p class="hero-sobremi__proposito">
        Ayudo a mujeres como vos a transformar su relación con el movimiento y el entrenamiento
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section__container section__container--narrow">
      <h2 class="section__title">Biografía</h2>
      <div class="bio">
        <div class="bio__parrafo">
          <h3 class="bio__heading">Quién soy</h3>
          <p class="bio__texto">
            [Texto placeholder — presentación personal, qué me llevó al fitness.]
          </p>
        </div>
        <div class="bio__parrafo">
          <h3 class="bio__heading">Mi filosofía</h3>
          <p class="bio__texto">
            ¿Desde qué emoción entrenamos? ¿Desde el amor que le tenemos a
            nuestro cuerpo o desde el rechazo hacia él? Cuando entendemos eso,
            comprendemos que entrenar no es un castigo por lo que comimos, ni
            una obligación para encajar en un ideal. Es un acto de cuidado.
          </p>
          <p class="bio__texto">
            Entrenamos para ser más fuertes, más saludables, para tener más
            energía, para sentirnos capaces y disfrutar de todo lo que nuestro
            cuerpo puede hacer.
          </p>
          <p class="bio__texto">
            Cuando el entrenamiento nace del amor propio, deja de ser una carga
            y se convierte en una herramienta para construir una mejor versión
            de nosotros mismos.
          </p>
          <p class="bio__texto">
            <strong>
              Un cuerpo fuerte empieza con un movimiento bien hecho.
              Acá vas a encontrar un entrenamiento con propósito, fuerza y conciencia corporal.
            </strong>
          </p>
        </div>
        <div class="bio__parrafo">
          <h3 class="bio__heading">Mi compromiso</h3>
          <p class="bio__texto">
            Que el entrenamiento deje de ser un castigo y se convierta en una
            herramienta para sentirse mejor, para vivir mejor, con más libertad,
            con más salud. Que sientas que entrenar no es solamente querer
            cambiar cómo se ve tu cuerpo, sino también <strong>transformar la menera en la que lo habitas.</strong>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <h2 class="section__title">Ludmila tu entrenadora</h2>
      <Gallery items={GALLERY} />
    </div>
  </section>

  <section class="section section--featured">
    <div class="section__container">
      <h2 class="section__title">Certificaciones</h2>
      <div class="cert-grid">
        {CERTIFICACIONES.map((cert) => (
  <CertificationCard {...cert} logo={certLogos[cert.acronym]} />
))}
      </div>
    </div>
  </section>

  <section class="section section--sm">
    <div class="section__container section__container--narrow">
      <h2 class="section__title">Contacto</h2>
      <ContactIcons />
    </div>
  </section>

  <section class="section section--featured">
    <div class="section__container section__container--narrow">
      <Frase
        texto="No se trata solo de hacer ejercicios, sino de aprender a moverte mejor."
      />
    </div>
  </section>

  <section class="section section--cta">
    <div class="section__container">
      <h2 class="section__title">COMIENZA TU TRANSFORMACIÓN CONMIGO</h2>
      <Button href="/asesorias" variant="internal" icon="arrow">
        Empezá hoy
      </Button>
    </div>
  </section>
</Layout>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Ludmila",
    description:
      "Personal trainer. Ayudo a personas a transformar su cuerpo y su relación con el movimiento.",
    jobTitle: "Personal Trainer",
    knowsAbout: "Personal Training",
    sameAs: [CONTACTO.WHATSAPP_BASE_URL, CONTACTO.INSTAGRAM_URL, CONTACTO.EMAIL_URL],
  })}
/>

<style>
  .hero-sobremi {
    padding: 4rem 1rem 2rem;
    text-align: center;
  }

  .hero-sobremi__content {
    max-width: 36rem;
    margin: 0 auto;
  }

  .hero-sobremi__image {
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    margin: 0 auto 1.5rem;
  }

  .hero-sobremi__title {
    font-family: var(--font-hero), sans-serif;
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .hero-sobremi__proposito {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .bio {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .bio__heading {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .bio__texto {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .cert-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .testimonios-inline {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .cert-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .testimonios-inline {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
