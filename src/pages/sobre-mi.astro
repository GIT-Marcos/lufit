---
import Layout from "../layouts/Layout.astro";
import HeroSplit from "../components/HeroSplit.astro";
import Button from "../components/Button.astro";
import ContactIcons from "../components/ContactIcons.astro";
import Frase from "../components/Frase.astro";
import CertificationCard from "../components/CertificationCard.astro";
import Gallery from "../components/Gallery.astro";
import { CONTACTO, getWhatsAppUrl } from "../data/contacto";
import { CERTIFICACIONES } from "../data/certificaciones";
import { GALLERY } from "../data/gallery";
import ipefLogo from "../assets/images/certificaciones/ipef.png";
import amaipLogo from "../assets/images/certificaciones/amaip.png";
import retrato from "../assets/images/about/sobre-mi.jpeg";
import JSONLDLocalBusiness from "../components/seo/JSONLDLocalBusiness.astro";

const certLogos: Record<string, string> = {
  "IPEF": ipefLogo.src,
  "AMAIP": amaipLogo.src,
};
---

<Layout
  title="Sobre Ludmila — Prof. Ed. Física | La Calera, Córdoba"
  description="Conocé a Ludmila, profesora de Educación Física. Filosofía, formación y acompañamiento profesional. Entrenamiento online y presencial en La Calera, Córdoba."
  breadcrumb={[
    { label: "Inicio", href: "/" },
    { label: "Sobre Mí", href: "/sobre-mi" },
  ]}
>
  <HeroSplit
    title="Ludmila — Prof. Ed. Física"
    subtitle="Ayudo a mujeres como vos a transformar su relación con el movimiento y el entrenamiento"
    image={retrato}
    imageAlt="Ludmila, profesora de Educación Física"
    ctas={[
      {
        text: "Conocé mis asesorías",
        href: "/asesorias",
        variant: "internal",
        icon: "arrow",
      },
      {
        text: "Escribime",
        href: getWhatsAppUrl(
          "¡Hola! Quiero saber sobre los entrenamientos"
        ),
        variant: "whatsapp",
        icon: "whatsapp",
        target: "_blank",
        rel: "noopener noreferrer",
      },
    ]}
  />

  <section class="section">
    <div class="section__container section__container--narrow">
      <h2 class="section__title">Conocé tu profesora</h2>
      <div class="bio">
        <div class="bio__parrafo">
          <h3 class="bio__heading">Quién soy</h3>
          <p class="bio__texto">
              Hola soy Ludmila García, Profesora Universitaria de Educación Física y fundadora de Librafit,
              un espacio dedicado al entrenamiento y la salud.
              Acompaño a mujeres que buscan mejorar su calidad de vida a través del movimiento, desarrollando
              hábitos saludables y una relación más consciente con su cuerpo.
              Mi objetivo en Librafit no es solo el cambio físico, sino ayudarte a vivir un
              <strong> proceso de entrenamiento consciente, donde ganes fuerza, confianza y disfrutes del camino.</strong>
          </p>
        </div>
        <div class="bio__parrafo">
          <h3 class="bio__heading">Mi filosofía</h3>
          <p class="bio__texto">
            ¿Desde qué emoción entrenamos? ¿Desde el amor que le tenemos a
            nuestro cuerpo o desde el rechazo hacia él? Cuando entendemos eso,
            comprendemos que entrenar no es un castigo por lo que comimos, ni
            una obligación para encajar en un ideal. Es un acto de cuidado.
          </p>
          <p class="bio__texto">
            Entrenamos para ser más fuertes, más saludables, para tener más
            energía, para sentirnos capaces y disfrutar de todo lo que nuestro
            cuerpo puede hacer.
          </p>
          <p class="bio__texto">
            Cuando el entrenamiento nace del amor propio, deja de ser una carga
            y se convierte en una herramienta para construir una mejor versión
            de nosotros mismos.
          </p>
          <p class="bio__texto">
            <strong>
              Un cuerpo fuerte empieza con un movimiento bien hecho.
              Acá vas a encontrar un entrenamiento con propósito, fuerza y conciencia corporal.
            </strong>
          </p>
        </div>
        <div class="bio__parrafo">
          <h3 class="bio__heading">Mi compromiso</h3>
          <p class="bio__texto">
            Que el entrenamiento deje de ser un castigo y se convierta en una
            herramienta para sentirse mejor, para vivir mejor, con más libertad,
            con más salud. Que sientas que entrenar no es solamente querer
            cambiar cómo se ve tu cuerpo, sino también <strong>transformar la manera en la que lo habitas.</strong>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <h2 class="section__title">Ludmila</h2>
      <Gallery items={GALLERY} />
    </div>
  </section>

  <section class="section section--featured">
    <div class="section__container">
      <h2 class="section__title">Certificaciones</h2>
      <div class="cert-grid">
        {CERTIFICACIONES.map((cert) => (
  <CertificationCard {...cert} logo={certLogos[cert.acronym]} />
))}
      </div>
    </div>
  </section>

  <section class="section section--sm">
    <div class="section__container section__container--narrow">
      <h2 class="section__title">Contacto</h2>
      <ContactIcons />
    </div>
  </section>

  <section class="section section--featured">
    <div class="section__container section__container--narrow">
      <Frase
        texto="No se trata solo de hacer ejercicios, sino de aprender a moverte mejor."
      />
    </div>
  </section>

  <section class="section section--cta">
    <div class="section__container">
      <h2 class="section__title">COMENZÁ TU TRANSFORMACIÓN CONMIGO</h2>
      <Button href="/asesorias" variant="internal" icon="arrow">
        Empezá hoy
      </Button>
    </div>
  </section>
  <JSONLDLocalBusiness image={new URL(retrato.src, import.meta.env.SITE).href} />
</Layout>

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Ludmila",
    description:
      "Profesora de Educación Física. Acompaño a personas a transformar su relación con el movimiento y el entrenamiento.",
    image: new URL(retrato.src, import.meta.env.SITE).href,
    jobTitle: "Profesora de Educación Física",
    knowsAbout: ["Educación Física", "Entrenamiento", "Salud", "Bienestar"],
    sameAs: [CONTACTO.WHATSAPP_BASE_URL, CONTACTO.INSTAGRAM_URL, CONTACTO.EMAIL_URL],
  })}
/>

<style>
  .bio {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .bio__heading {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .bio__texto {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .cert-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .testimonios-inline {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .cert-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .testimonios-inline {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
