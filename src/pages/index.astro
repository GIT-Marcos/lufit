---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Button from "../components/Button.astro";
import Stats from "../components/Stats.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import { CONTACTO } from "../data/contacto";
import bannerImage from "../assets/images/banner.jpg";

interface Testimonio {
  nombre: string;
  texto: string;
}

const stats = [
  { valor: "5+", label: "años de experiencia" },
  { valor: "50+", label: "alumnas transformadas" },
  { valor: "Online y Presencial", label: "modalidades" },
  { valor: "100%", label: "resultados reales" },
];

const servicios = [
{
    title: "Presencial",
    description: "Entrená en mi gimnasio",
    cta: { text: "Conocé más", href: "/asesorias" },
  },
  {
    title: "Online",
    description: "Entrená desde tu casa",
    cta: { text: "Conocé más", href: "/asesorias" },
  },
];

const testimonios: Testimonio[] = [
  {
    nombre: "María G.",
    texto:
      "Todo lo que haces por tus alumnas es genial. Sos muy grosa y muy humana.",
  },
  {
    nombre: "Julieta P.",
    texto:
      "Este tiempo me sirvió muchísimo, me he estirado, ya puedo atarme los cordones; no me canso tanto. Mil gracias.",
  },
  {
    nombre: "Ana L.",
    texto:
      "Nunca pensé estar de vacaciones y sentir la necesidad de moverme, de entrenar. Estoy muy motivada desde que arranqué a entrenar con vos.",
  },
  {
    nombre: "Florencia M.",
    texto:
      "Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt.",
  },
];
---

<Layout
  title="Ludmila — Personal Trainer"
  description="Transformá tu cuerpo con planes de entrenamiento personalizados. Online o presencial. Empezá hoy tu cambio."
>
  <Hero
    title="Transformá tu cuerpo, transformá tu vida"
    subtitle="Planes de entrenamiento personalizados con acompañamiento continuo. Online o presencial, vos elegís."
    identity="Ludmila — Personal Trainer"
    ctas={[
      { text: "Empezá hoy", href: "/asesorias", variant: "internal", icon: "arrow" },
      {
        text: "Armemos tu plan",
        href: CONTACTO.FORM_EVALUACION_URL,
        variant: "evaluacion",
        icon: "form",
        target: "_blank",
        rel: "noopener noreferrer",
      },
    ]}
    image={{ src: bannerImage.src, alt: "Ludmila entrenando" }}
  />

  <section class="section">
    <Stats items={stats} />
  </section>

  <section class="section section--featured">
    <div class="section__container">
      <h2 class="section__title">Planes Personalizados con Seguimiento</h2>
      <div class="servicios-grid">
          {
            servicios.map((s) => (
              <article class="servicio-card">
                <h3 class="servicio-card__title">{s.title}</h3>
                <p class="servicio-card__description">{s.description}</p>
                <Button href={s.cta.href} variant="internal" icon="arrow">{s.cta.text}</Button>
              </article>
            ))
          }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <h2 class="section__title">Resultados reales</h2>
      <div class="testimonios-grid">
        {
          testimonios.map((t) => (
            <TestimonialCard nombre={t.nombre} texto={t.texto} />
          ))
        }
      </div>
      <div class="section__cta">
        <Button href={CONTACTO.INSTAGRAM_HIGHLIGHT_URL} variant="instagram" icon="instagram" target="_blank" rel="noopener noreferrer">Ver resultados en Instagram</Button>
      </div>
    </div>
  </section>

  <section class="section section--cta">
    <div class="section__container">
      <h2 class="section__title">¿Lista para empezar tu transformación?</h2>
      <Button href={CONTACTO.FORM_EVALUACION_URL} variant="evaluacion" icon="form" target="_blank" rel="noopener noreferrer">Armemos tu plan</Button>
    </div>
  </section>
</Layout>

<style>
  .section {
    padding: 4rem 1rem;
  }

  .section--featured {
    background: var(--color-surface);
  }

  .section--cta {
    text-align: center;
    background: var(--color-primary);
    color: white;
  }

  .section--cta .section__title {
    color: white;
    margin-bottom: 1.5rem;
  }

  .section__container {
    max-width: 64rem;
    margin: 0 auto;
  }

  .section__title {
    text-align: center;
    margin-bottom: 2rem;
  }

  .section__cta {
    text-align: center;
    margin-top: 2rem;
  }

  .servicios-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .servicio-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 2rem;
    text-align: center;
  }

  .servicio-card__title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .servicio-card__description {
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
  }

  .testimonios-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .servicios-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .testimonios-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .testimonios-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
