---
import Layout from "../layouts/Layout.astro";
import HeroSplit from "../components/HeroSplit.astro";
import Button from "../components/Button.astro";
import Stats from "../components/Stats.astro";
import Frase from "../components/Frase.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import { CONTACTO } from "../data/contacto";
import { STATS } from "../data/stats";
import { ASESORIA_ONLINE, PRESENCIAL_ALERTA } from "../data/servicios";
import heroImage from "../assets/images/hero/inicio.jpeg";

interface Testimonio {
  nombre: string;
  texto: string;
}

const testimonios: Testimonio[] = [
  /*
  {
    nombre: "María.",
    texto:
      "Todo lo que haces por tus alumnas es genial. Sos muy grosa y muy humana.",
  },
  */
  {
    nombre: "Julieta.",
    texto:
      "Este tiempo me sirvió muchísimo, me he estirado, ya puedo atarme los cordones; no me canso tanto. Mil gracias.",
  },
  {
    nombre: "Paula.",
    texto:
      "Para mí ya es perfecto, me ayudaste y motivaste siempre , estabas al pendiente de si estaba cómoda, cómo venía y te adaptabas a mis problemas de salud.",
  },
  {
    nombre: "María.",
    texto:
      "Lograr una disciplina y constancia, siempre que empezaba a hacer ejercicio no era constante pero con este programa desde el día 1 soy constante. También me siento con más energía, con más elasticidad y con más brillo.",
  },
  {
    nombre: "Ana.",
    texto:
      "Nunca pensé estar de vacaciones y sentir la necesidad de moverme, de entrenar. Estoy muy motivada desde que arranqué a entrenar con vos.",
  },
];
---

<Layout
  title="Entrenadora Personal Online y Presencial | Ludmila"
  description="Entrenadora personal online y presencial en La Calera, Córdoba. Planes personalizados con acompañamiento continuo. Empezá hoy tu cambio."
>
  <HeroSplit
    title="Entrenar no es solamente verse mejor, también es sentirse mejor"
    subtitle="Planes de entrenamiento personalizados con acompañamiento continuo. Online o presencial, vos elegís."
    identity="Ludmila — Personal Trainer"
    ctas={[
      { text: "Empezá hoy", href: "/asesorias", variant: "internal", icon: "arrow" },
      {
        text: "Armemos tu plan",
        href: CONTACTO.FORM_EVALUACION_URL,
        variant: "evaluacion",
        size: "lg",
        icon: "form",
        target: "_blank",
        rel: "noopener noreferrer",
      },
    ]}
    image={heroImage}
    imageAlt="Ludmila"
  />

  <section class="section">
    <div class="section__container">
      <h2 id="stats-heading" class="section__title">Resultados que hablan</h2>
      <Stats items={STATS} />
    </div>
  </section>

  <section class="section section--sm section--no-separator" aria-label="Filosofía de entrenamiento">
    <div class="section__container section__container--narrow">
      <Frase
        texto="No busco que dependas de un entrenamiento. Busco que entiendas tu cuerpo,
        descubras tu fuerza y te lleves herramientas para toda la vida."
      />
    </div>
  </section>

  <section class="section section--featured" aria-labelledby="servicios-heading">
    <div class="section__container">
      <h2 id="servicios-heading" class="section__title">
        Tu plan online, conmigo al lado
      </h2>

      <article class="servicio-card servicio-card--featured">
        <span class="servicio-card__badge" aria-hidden="true">✨ Recomendado</span>
        <h3 class="servicio-card__title">{ASESORIA_ONLINE.titulo}</h3>
        <p class="servicio-card__description">{ASESORIA_ONLINE.descripcion}</p>

        <ul class="servicio-card__beneficios">
          {
            ASESORIA_ONLINE.beneficios.map((b) => (
              <li class="servicio-card__beneficio">
                <span class="servicio-card__beneficio-icono" aria-hidden="true">
                  {b.icono}
                </span>
                <span>{b.texto}</span>
              </li>
            ))
          }
        </ul>

        <Button
          href={ASESORIA_ONLINE.cta.href}
          variant="internal"
          icon="arrow"
          size="lg"
        >
          {ASESORIA_ONLINE.cta.texto}
        </Button>
      </article>

      <p class="servicio-card__alternativa">
        {PRESENCIAL_ALERTA.texto}{' '}
        <a href={PRESENCIAL_ALERTA.linkHref}>{PRESENCIAL_ALERTA.linkTexto}</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section__container">
      <h2 class="section__title">Resultados reales</h2>
      <div class="testimonios-grid">
        {
          testimonios.map((t) => (
            <TestimonialCard nombre={t.nombre} texto={t.texto} />
          ))
        }
      </div>
      <div class="section__cta">
        <Button href={CONTACTO.INSTAGRAM_HIGHLIGHT_URL} variant="instagram" icon="instagram" target="_blank" rel="noopener noreferrer">Ver resultados en Instagram</Button>
      </div>
    </div>
  </section>

  <section class="section section--cta">
    <div class="section__container">
      <h2 class="section__title">¿LISTA PARA EMPEZAR TU TRANSFORMACIÓN?</h2>
      <Button href={CONTACTO.FORM_EVALUACION_URL} variant="evaluacion" size="lg" icon="form" target="_blank" rel="noopener noreferrer">Armemos tu plan</Button>
    </div>
  </section>
</Layout>

<style>
  .servicio-card--featured {
    max-width: 38rem;
    margin: 0 auto;
    background: radial-gradient(ellipse at 50% 0%, color-mix(in srgb, var(--color-primary), transparent 88%), var(--color-surface) 70%);
    border: 2px solid var(--color-primary);
    border-radius: 1rem;
    padding: 2.5rem 2rem;
    text-align: center;
    position: relative;
    box-shadow: var(--shadow-lg);
    transition: transform var(--transition-base),
                box-shadow var(--transition-base);
  }

  .servicio-card--featured:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }

  .servicio-card__badge {
    position: absolute;
    top: -1rem;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-primary);
    color: white;
    font-size: 1rem;
    font-weight: 600;
    padding: 0.25rem 1rem;
    border-radius: 999px;
    white-space: nowrap;
  }

  .servicio-card__title {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .servicio-card__description {
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
    max-width: 28rem;
    margin-left: auto;
    margin-right: auto;
  }

  .servicio-card__beneficios {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin-bottom: 2rem;
    text-align: left;
    max-width: 22rem;
    margin-left: auto;
    margin-right: auto;
  }

  .servicio-card__beneficio {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 1.1rem;
    color: var(--color-text);
    line-height: 1.4;
  }

  .servicio-card__beneficio-icono {
    flex-shrink: 0;
    font-size: 1.4rem;
    width: 1.5rem;
    text-align: center;
    margin-right: 0.4rem;
  }

  .servicio-card__alternativa {
    text-align: center;
    margin-top: 1.5rem;
    font-size: 1.1rem;
    color: var(--color-text-secondary);
  }

  .servicio-card__alternativa a {
    font-weight: 600;
  }

  .testimonios-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .servicio-card__beneficios {
      grid-template-columns: repeat(2, 1fr);
      max-width: 32rem;
    }

    .servicio-card--featured {
      padding: 3rem 2.5rem;
    }

    .testimonios-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .testimonios-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
