---
export interface Props {
  institution: string;
  acronym: string;
  logo: string;
  year: number;
  title: string;
}

const { institution, acronym, logo, year, title } = Astro.props;
---

<article class="cert-card">
  <div class="cert-card__left">
    <img src={logo} alt={`${acronym} — ${institution}`} class="cert-card__logo" loading="lazy" />
    <span class="cert-card__year">{year}</span>
  </div>
  <div class="cert-card__body">
    <div>
      <h3 class="cert-card__name">{institution}</h3>
      <p class="cert-card__title">{title}</p>
    </div>
  </div>
</article>

<style>
  .cert-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1.25rem;
    display: flex;
    gap: 1.25rem;
    transition: transform var(--transition-base, 0.2s ease),
                box-shadow var(--transition-base, 0.2s ease);
  }

  .cert-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md, 0 4px 12px rgba(0, 0, 0, 0.08));
  }

  .cert-card__left {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    width: 80px;
  }

  .cert-card__logo {
    width: 100%;
    height: auto;
    object-fit: contain;
    border-radius: 0.375rem;
  }

  .cert-card__year {
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    font-weight: 500;
    white-space: nowrap;
  }

  .cert-card__body {
    flex: 1;
    display: flex;
    align-items: center;
  }

  .cert-card__name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.4;
    margin: 0;
  }

  .cert-card__title {
    font-size: 0.875rem;
    color: var(--color-primary);
    font-weight: 500;
    margin: 0.25rem 0 0;
    line-height: 1.4;
  }
</style>
