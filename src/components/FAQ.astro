---
export interface FAQItem {
  pregunta: string;
  respuesta: string;
}

export interface Props {
  items: FAQItem[];
}

const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details class="faq__item">
        <summary class="faq__pregunta">
          {item.pregunta}
          <span class="faq__icono" aria-hidden="true">+</span>
        </summary>
        <div class="faq__respuesta">
          <p>{item.respuesta}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 2rem 1rem;
    max-width: 48rem;
    margin: 0 auto;
  }

  .faq__item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .faq__pregunta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq__pregunta::-webkit-details-marker {
    display: none;
  }

  .faq__icono {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-primary);
    transition: transform 0.2s ease;
    flex-shrink: 0;
    margin-left: 1rem;
  }

  .faq__item[open] .faq__icono {
    transform: rotate(45deg);
  }

  .faq__respuesta {
    padding: 0 1.25rem 1.25rem;
  }

  .faq__respuesta p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }
</style>
