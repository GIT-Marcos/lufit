---
export interface Pilar {
  titulo: string;
  descripcion: string;
  icono: string;
}

export interface Props {
  pilares: Pilar[];
  beneficios: string[];
}

const { pilares, beneficios } = Astro.props;
---

<article class="pilares-card">
  <div class="pilares-card__pilares">
    {pilares.map((p) => (
      <div class="pilares-card__pilar">
        <span class="pilares-card__icono" aria-hidden="true">{p.icono}</span>
        <h3 class="pilares-card__pilar-title">{p.titulo}</h3>
        <p class="pilares-card__pilar-desc">{p.descripcion}</p>
      </div>
    ))}
  </div>

  <div class="pilares-card__beneficios">
    <p class="pilares-card__beneficios-label">Esto te permite:</p>
    <ul class="pilares-card__lista">
      {beneficios.map((b) => (
        <li class="pilares-card__beneficio">
          <span class="pilares-card__check" aria-hidden="true">✓</span>
          <span>{b}</span>
        </li>
      ))}
    </ul>
  </div>
</article>

<style>
  .pilares-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 2rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    max-width: 48rem;
    margin: 0 auto;
  }

  .pilares-card__pilares {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    text-align: center;
  }

  .pilares-card__pilar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.375rem;
  }

  .pilares-card__icono {
    font-size: 2rem;
    line-height: 1;
  }

  .pilares-card__pilar-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .pilares-card__pilar-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .pilares-card__beneficios {
    border-top: 1px solid var(--color-border);
    padding-top: 1.25rem;
    text-align: center;
  }

  .pilares-card__beneficios-label {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }

  .pilares-card__lista {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.5rem;
    text-align: left;
  }

  .pilares-card__beneficio {
    display: flex;
    align-items: flex-start;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  .pilares-card__check {
    flex-shrink: 0;
    color: var(--color-secondary);
    font-weight: 700;
  }

  @media (min-width: 640px) {
    .pilares-card__pilares {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
