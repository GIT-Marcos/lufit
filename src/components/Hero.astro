---
import Button from "./Button.astro";

export interface CTA {
  text: string;
  href: string;
  variant?: "primary" | "secondary" | "whatsapp" | "internal" | "instagram";
}

export interface Props {
  title: string;
  subtitle?: string;
  identity?: string;
  ctas?: CTA[];
  image?: { src: string; alt: string };
}

const { title, subtitle, identity, ctas, image } = Astro.props;
---

<section class="hero">
  {
    image && (
      <img
        src={image.src}
        alt={image.alt}
        class="hero__image"
        fetchpriority="high"
      />
    )
  }
  <div class="hero__content">
    {identity && <p class="hero__identity">{identity}</p>}
    <h1 class="hero__title">{title}</h1>
    {subtitle && <p class="hero__subtitle">{subtitle}</p>}
    {
      ctas && ctas.length > 0 && (
        <div class="hero__ctas">
          {ctas.map((cta) => (
            <Button href={cta.href} variant={cta.variant || "primary"}>
              {cta.text}
            </Button>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    text-align: center;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    max-width: 48rem;
  }

  .hero__identity {
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .hero__title {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  .hero__subtitle {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    margin-bottom: 2rem;
    line-height: 1.6;
  }

  .hero__ctas {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (min-width: 768px) {
    .hero__title {
      font-size: 3rem;
    }

    .hero__subtitle {
      font-size: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    .hero__title {
      font-size: 3.5rem;
    }
  }
</style>
