---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Button from "./Button.astro";

export interface CTA {
  text: string;
  href: string;
  variant?: "primary" | "secondary" | "whatsapp" | "internal" | "instagram" | "evaluacion";
  size?: "sm" | "md" | "lg";
  icon?: "whatsapp" | "instagram" | "form" | "arrow";
  target?: string;
  rel?: string;
}

export interface Props {
  title: string;
  subtitle?: string;
  identity?: string;
  ctas?: CTA[];
  image?: ImageMetadata;
  imageAlt?: string;
}

const { title, subtitle, identity, ctas, image, imageAlt } = Astro.props;
const isSvg = image?.format === 'svg';
---

<section class="hero">
  {
    image && isSvg && (
      <img
        src={image.src}
        alt={imageAlt || ""}
        class="hero__image"
        fetchpriority="high"
      />
    )
  }
  {
    image && !isSvg && (
      <Picture
        src={image}
        alt={imageAlt || ""}
        class="hero__image"
        formats={["avif", "webp"]}
        widths={[640, 1280, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    )
  }
  <div class="hero__content">
    {identity && <p class="hero__identity">{identity}</p>}
    <h1 class="hero__title">{title}</h1>
    {subtitle && <p class="hero__subtitle">{subtitle}</p>}
    {
      ctas && ctas.length > 0 && (
        <div class="hero__ctas">
          {ctas.map((cta) => (
            <Button href={cta.href} variant={cta.variant || "primary"} size={cta.size} icon={cta.icon} target={cta.target} rel={cta.rel}>
              {cta.text}
            </Button>
          ))}
        </div>
      )
    }
  </div>
</section>
<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
    text-align: center;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(0, 0, 0, 0.35);
    pointer-events: none;
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    max-width: 48rem;
  }

  .hero__identity {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    margin-bottom: 1rem;
    background: rgba(0, 0, 0, 0.25);
    backdrop-filter: blur(4px);
    padding: 0.35rem 1.25rem;
    border-radius: 999px;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.3);
  }

  .hero__title {
    font-family: var(--font-hero), sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: white;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  }

  .hero__subtitle {
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: 2rem;
    line-height: 1.6;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.3);
  }

  .hero__ctas {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (min-width: 768px) {
    .hero__title {
      font-size: 3rem;
    }

    .hero__subtitle {
      font-size: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    .hero__title {
      font-size: 3.5rem;
    }
  }
</style>
