---
import IconWhatsApp from "./icons/IconWhatsApp.astro";
import IconInstagram from "./icons/IconInstagram.astro";
import IconForm from "./icons/IconForm.astro";

export interface Props {
  variant?: "primary" | "secondary" | "outline" | "whatsapp" | "evaluacion" | "internal" | "instagram";
  size?: "sm" | "md" | "lg";
  href: string;
  icon?: "whatsapp" | "instagram" | "form" | "arrow";
  target?: string;
  rel?: string;
}

const { variant = "primary", size = "md", href, icon, target, rel } = Astro.props;
---

<a href={href} target={target} rel={rel} class={`button button--${variant} button--${size}${icon ? " button--with-icon" : ""}`}>
  <slot />
  {icon === "whatsapp" && <IconWhatsApp />}
  {icon === "instagram" && <IconInstagram />}
  {icon === "form" && <IconForm />}
  {icon === "arrow" && (
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
    </svg>
  )}
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    border: 2px solid transparent;
    box-shadow: var(--shadow-sm);
    transition: background-color var(--transition-base),
                color var(--transition-base),
                box-shadow var(--transition-base),
                transform var(--transition-base);
  }

  .button:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }

  .button:focus-visible {
    outline: none;
    box-shadow: var(--shadow-md), 0 0 0 3px rgba(234, 88, 12, 0.25);
  }

  .button--sm {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
  }

  .button--md {
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
  }

  .button--lg {
    padding: 1rem 2rem;
    font-size: 1.125rem;
  }

  .button--primary {
    background: linear-gradient(135deg, var(--color-primary), color-mix(in srgb, var(--color-primary), black 20%));
    color: white;
  }

  .button--primary:hover {
    background: linear-gradient(135deg, var(--color-primary-dark), color-mix(in srgb, var(--color-primary-dark), black 20%));
    color: white;
  }

  .button--secondary {
    background: linear-gradient(135deg, var(--color-secondary), color-mix(in srgb, var(--color-secondary), black 20%));
    color: white;
  }

  .button--secondary:hover {
    background: linear-gradient(135deg, var(--color-secondary-dark), color-mix(in srgb, var(--color-secondary-dark), black 20%));
    color: white;
  }

  .button--outline {
    background: transparent;
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .button--outline:hover {
    background: var(--color-primary);
    color: white;
  }

  .button--whatsapp {
    background: linear-gradient(135deg, var(--color-secondary), color-mix(in srgb, var(--color-secondary), black 20%));
    color: white;
  }

  .button--whatsapp:hover {
    background: linear-gradient(135deg, var(--color-secondary-dark), color-mix(in srgb, var(--color-secondary-dark), black 20%));
    color: white;
  }

  .button--evaluacion {
    background: linear-gradient(135deg, var(--color-evaluacion), color-mix(in srgb, var(--color-evaluacion), black 20%));
    color: white;
    outline: 1px solid color-mix(in srgb, var(--color-evaluacion), white 30%);
    outline-offset: -3px;
    animation: button-glow 2.5s ease-in-out infinite;
  }

  .button--evaluacion:hover {
    background: linear-gradient(135deg, var(--color-evaluacion-dark), color-mix(in srgb, var(--color-evaluacion-dark), black 20%));
    color: white;
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 0 24px color-mix(in srgb, var(--color-evaluacion), transparent 20%);
    animation: none;
  }

  @keyframes button-glow {
    0%, 100% {
      box-shadow: 0 0 8px color-mix(in srgb, var(--color-evaluacion), transparent 60%);
    }
    50% {
      box-shadow: 0 0 18px color-mix(in srgb, var(--color-evaluacion), transparent 30%);
    }
  }

  .button--internal {
    background: linear-gradient(135deg, var(--color-blue), color-mix(in srgb, var(--color-blue), black 20%));
    color: white;
  }

  .button--internal:hover {
    background: linear-gradient(135deg, var(--color-blue-dark), color-mix(in srgb, var(--color-blue-dark), black 20%));
    color: white;
  }

  .button--instagram {
    background: linear-gradient(135deg, var(--color-instagram), color-mix(in srgb, var(--color-instagram), black 20%));
    color: white;
  }

  .button--instagram:hover {
    background: linear-gradient(135deg, var(--color-instagram-dark), color-mix(in srgb, var(--color-instagram-dark), black 20%));
    color: white;
  }

  .button--with-icon {
    gap: 0.5rem;
  }
</style>
