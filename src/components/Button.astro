---
import IconWhatsApp from "./icons/IconWhatsApp.astro";
import IconInstagram from "./icons/IconInstagram.astro";
import IconForm from "./icons/IconForm.astro";

export interface Props {
  variant?: "primary" | "secondary" | "outline" | "whatsapp" | "evaluacion" | "internal" | "instagram";
  href: string;
  icon?: "whatsapp" | "instagram" | "form" | "arrow";
  target?: string;
  rel?: string;
}

const { variant = "primary", href, icon, target, rel } = Astro.props;
---

<a href={href} target={target} rel={rel} class={`button button--${variant}${icon ? " button--with-icon" : ""}`}>
  <slot />
  {icon === "whatsapp" && <IconWhatsApp />}
  {icon === "instagram" && <IconInstagram />}
  {icon === "form" && <IconForm />}
  {icon === "arrow" && (
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
    </svg>
  )}
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
    border: 2px solid transparent;
  }

  .button--primary {
    background: var(--color-primary);
    color: white;
  }

  .button--primary:hover {
    background: var(--color-primary-dark);
    color: white;
  }

  .button--secondary {
    background: var(--color-secondary);
    color: white;
  }

  .button--secondary:hover {
    background: var(--color-secondary-dark);
    color: white;
  }

  .button--outline {
    background: transparent;
    color: var(--color-primary);
    border-color: var(--color-primary);
  }

  .button--outline:hover {
    background: var(--color-primary);
    color: white;
  }

  .button--whatsapp {
    background: var(--color-secondary);
    color: white;
  }

  .button--whatsapp:hover {
    background: var(--color-secondary-dark);
    color: white;
  }

  .button--evaluacion {
    background: #5a0cea;
    color: white;
  }

  .button--evaluacion:hover {
    background: #4a0bc0;
    color: white;
  }

  .button--internal {
    background: var(--color-blue);
    color: white;
  }

  .button--internal:hover {
    background: var(--color-blue-dark);
    color: white;
  }

  .button--instagram {
    background: var(--color-instagram);
    color: white;
  }

  .button--instagram:hover {
    background: var(--color-instagram-dark);
    color: white;
  }

  .button--with-icon {
    gap: 0.5rem;
  }
</style>
