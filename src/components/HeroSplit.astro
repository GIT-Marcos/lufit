---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import Button from "./Button.astro";

export interface CTA {
  text: string;
  href: string;
  variant?: "primary" | "secondary" | "whatsapp" | "internal" | "instagram" | "evaluacion";
  size?: "sm" | "md" | "lg";
  icon?: "whatsapp" | "instagram" | "form" | "arrow";
  target?: string;
  rel?: string;
}

export interface Props {
  title: string;
  subtitle?: string;
  identity?: string;
  ctas?: CTA[];
  image?: ImageMetadata;
  imageAlt?: string;
}

const { title, subtitle, identity, ctas, image, imageAlt } = Astro.props;
---

<section class="hero-split">
  <div class="hero-split__content">
    {
      image && (
        <figure class="hero-split__media">
          <Picture
            src={image}
            alt={imageAlt || ""}
            class="hero-split__image"
            formats={["webp"]}
            widths={[320, 640, 1280, 1920]}
            sizes="(min-width: 768px) 40rem, 100vw"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )
    }
    <div class="hero-split__texto">
      {identity && <p class="hero-split__identity">{identity}</p>}
      <h1 class="hero-split__title">{title}</h1>
      {subtitle && <p class="hero-split__subtitle">{subtitle}</p>}
      {
        ctas && ctas.length > 0 && (
          <div class="hero-split__ctas">
            {ctas.map((cta) => (
              <Button
                href={cta.href}
                variant={cta.variant || "primary"}
                size={cta.size}
                icon={cta.icon}
                target={cta.target}
                rel={cta.rel}
              >
                {cta.text}
              </Button>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .hero-split {
    padding: 4rem 1rem 2rem;
  }

  .hero-split__content {
    max-width: 64rem;
    margin: 0 auto;
    display: grid;
    gap: 2.5rem;
  }

  .hero-split__media {
    position: relative;
    width: 100%;
    max-width: 40rem;
    margin: 0 auto;
  }

  .hero-split__image {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    border-radius: 16px 40px 16px 40px;
    border: none;
    box-shadow: 0 20px 60px -10px rgba(234, 88, 12, 0.8),
                0 8px 20px -6px rgba(0, 0, 0, 0.7);
  }

  .hero-split__texto {
    text-align: center;
  }

  .hero-split__identity {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .hero-split__title {
    font-family: var(--font-hero), sans-serif;
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .hero-split__subtitle {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .hero-split__ctas {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .hero-split__content {
      grid-template-columns: minmax(0, 40rem) 1fr;
      align-items: center;
    }

    .hero-split__texto {
      text-align: left;
    }

    .hero-split__ctas {
      justify-content: flex-start;
    }
  }
</style>
