---
import { BUSINESS_DATA } from '../../data/business';

interface Props {
  image: string;
  extraSchema?: Record<string, any>;
}

const { image, extraSchema = {} } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": BUSINESS_DATA.id,
  "name": BUSINESS_DATA.name,
  "description": BUSINESS_DATA.description,
  "url": BUSINESS_DATA.url,
  "logo": BUSINESS_DATA.logo,
  "image": image,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": BUSINESS_DATA.address.locality,
    "addressRegion": BUSINESS_DATA.address.region,
    "addressCountry": BUSINESS_DATA.address.country
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": BUSINESS_DATA.geo.latitude,
    "longitude": BUSINESS_DATA.geo.longitude
  },
  "areaServed": BUSINESS_DATA.areaServed.map(area => ({
    "@type": area.type,
    "name": area.name
  })),
  "telephone": BUSINESS_DATA.telephone,
  "sameAs": BUSINESS_DATA.sameAs,
  "priceRange": "$$",
  "founder": {
    "@type": "Person",
    "@id": "https://ludmi-fit.vercel.app/#person",
    "name": "Ludmila García"
  },
  // openingHours deliberadamente omitido: los horarios son por
  // conveniencia del cliente y cambian frecuentemente. Incluirlos
  // con valores incorrectos perjudica la confianza de Google.
  ...extraSchema
};
---
<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
