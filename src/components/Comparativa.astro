---
export interface Columna {
  titulo: string;
  items: string[];
  destacada?: boolean;
}

export interface Props {
  columnas: [Columna, Columna];
}

const { columnas } = Astro.props;
---

<div class="comparativa">
  {
    columnas.map((columna) => (
      <div class="comparativa__columna" class:list={{ 'comparativa__columna--destacada': columna.destacada }}>
        {columna.destacada && <span class="comparativa__badge">✨ Recomendado</span>}
        <h3 class="comparativa__titulo">{columna.titulo}</h3>
        <ul class="comparativa__lista">
          {columna.items.map((item) => (
            <li class="comparativa__item">{item}</li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

<style>
  .comparativa {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    padding: 2rem 1rem;
  }

  .comparativa__columna {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1.5rem;
    transition: transform var(--transition-base),
                box-shadow var(--transition-base);
  }

  .comparativa__columna:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-hover);
  }

  .comparativa__titulo {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 1rem;
    text-align: center;
  }

  .comparativa__lista {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .comparativa__item {
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    padding-left: 1.5rem;
    position: relative;
  }

  .comparativa__item::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-secondary);
    font-weight: 900;
  }

  .comparativa__columna--destacada {
    border-color: var(--color-primary);
    border-width: 2px;
    position: relative;
  }

  .comparativa__columna--destacada .comparativa__titulo {
    color: var(--color-primary-dark);
  }

  .comparativa__badge {
    display: inline-block;
    padding: 0.2rem 0.7rem;
    background: var(--color-primary);
    color: white;
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: 999px;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    line-height: 1.4;
  }

  @media (min-width: 768px) {
    .comparativa {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
