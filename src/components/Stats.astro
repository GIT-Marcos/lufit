---
export interface StatsItem {
  valor: string;
  label: string;
}

export interface Props {
  items: StatsItem[];
}

const { items } = Astro.props;
---

<dl class="stats" role="list" aria-labelledby="stats-heading">
  {
    items.map((item) => (
      <div class="stats__item">
        <dt class="stats__valor">{item.valor}</dt>
        <dd class="stats__label">{item.label}</dd>
      </div>
    ))
  }
</dl>

<style>
  .stats {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    padding: 2rem 1rem;
  }

  .stats__item {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    position: relative;
  }

  .stats__valor {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .stats__label {
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  @media (min-width: 768px) {
    .stats {
      gap: 0;
    }

    .stats__item {
      padding: 0 2rem;
    }

    .stats__item + .stats__item::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 2px;
      height: 100%;
      background: linear-gradient(180deg, transparent, var(--color-primary) 50%, transparent);
    }

    .stats__valor {
      font-size: 2.5rem;
    }
  }

  @media (max-width: 767px) {
    .stats {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0;
    }

    .stats__item {
      padding: 1.5rem 1rem;
    }

    .stats__item:nth-child(odd)::after {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      width: 2px;
      height: 100%;
      background: linear-gradient(180deg, transparent, var(--color-primary) 50%, transparent);
    }

    .stats__item:nth-child(-n+2)::before {
      content: '';
      position: absolute;
      left: 0;
      bottom: 0;
      width: 100%;
      height: 2px;
      background: linear-gradient(90deg, transparent, var(--color-primary) 50%, transparent);
    }
  }
</style>
