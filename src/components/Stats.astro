---
export interface StatsItem {
  valor: string;
  label: string;
}

export interface Props {
  items: StatsItem[];
}

const { items } = Astro.props;
---

<ul class="stats" role="list" aria-labelledby="stats-heading">
  {
    items.map((item) => (
      <li class="stats__item">
        <strong class="stats__valor">{item.valor}</strong>
        <span class="stats__label">{item.label}</span>
      </li>
    ))
  }
</ul>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
  }

  .stats__item {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    position: relative;
    padding: 1.5rem 1rem;
  }

  .stats__item:nth-child(odd)::after {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 2px;
    height: 100%;
    background: linear-gradient(180deg, transparent, var(--color-primary) 50%, transparent);
  }

  .stats__item:nth-child(-n+2)::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-primary) 50%, transparent);
  }

  .stats__valor {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .stats__label {
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    line-height: 1.3;
  }

  @media (min-width: 768px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }

    .stats__item {
      padding: 0 1.5rem;
      justify-content: center;
    }

    .stats__item::before,
    .stats__item::after {
      display: none;
    }

    .stats__item:not(:first-child)::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 2px;
      height: 100%;
      background: linear-gradient(180deg, transparent, var(--color-primary) 50%, transparent);
      display: block;
    }

    .stats__valor {
      font-size: 2.5rem;
    }

    .stats__label {
      font-size: 1.2rem;
    }
  }
</style>
